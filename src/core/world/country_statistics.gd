class_name CountryStatistics
extends RefCounted
## The sourced key figures for every record, loaded read-only.
##
## Nothing here computes, estimates or fills anything in. The file it reads is
## generated by `tools/build_statistics.py` from one pinned, licensed source, and it
## already carries each value's as-of year and its source field. This class only
## answers questions about those numbers, and it says **no** clearly when there are
## none: `value(id, key)` returns `null` for a missing figure, never `0`, because a
## zero means "the source says zero" (two uninhabited territories really do).
##
## Deliberately absent: any write path, any link to `WorldState`, the simulation or a
## save. These figures are a baseline for a later milestone; until then the game shows
## them and nothing changes them.

const DEFAULT_PATH := "res://data/world/statistics.json"

## Display order and plain-language labels. Kept here, not in the file, so the words
## a player reads live with the code that formats them.
const INDICATORS := [
	{"key": "population", "label": "Population", "unit": "people"},
	{"key": "gdp_usd", "label": "GDP", "unit": "US dollars"},
	{"key": "area_km2", "label": "Area", "unit": "km²"},
]

var schema := 0
var notice := ""
var source: Dictionary = {}
var missing_text := "Not available"

var _countries: Dictionary = {}
var _indicators: Array = []


static func load_default() -> CountryStatistics:
	return from_file(DEFAULT_PATH)


static func from_file(path: String) -> CountryStatistics:
	var statistics := CountryStatistics.new()
	var data: Variant = DataLoader.load_json(path)
	if data is Dictionary:
		statistics._read(data as Dictionary)
	return statistics


func _read(data: Dictionary) -> void:
	schema = int(data.get("schema", 0))
	notice = str(data.get("notice", ""))
	source = data.get("source", {}) if data.get("source") is Dictionary else {}
	var countries: Variant = data.get("countries")
	if countries is Dictionary:
		_countries = countries
	var indicators: Variant = data.get("indicators")
	if indicators is Array:
		_indicators = indicators


func is_loaded() -> bool:
	return not _countries.is_empty()


func count() -> int:
	return _countries.size()


func has(country_id: String) -> bool:
	return _countries.has(country_id) and not (_countries[country_id] as Dictionary).is_empty()


## Every indicator this build knows about, in display order, with the label and unit
## a screen should show. Not read from the data file: the file supplies numbers, the
## code supplies words.
func definitions() -> Array:
	return INDICATORS.duplicate(true)


## One figure for one record: `{value, year, derived, method, as_of_label, source_field}`,
## or an empty dictionary when the source has no value for it. Never invents a zero.
func figure(country_id: String, key: String) -> Dictionary:
	if not has(country_id):
		return {}
	var entry: Variant = (_countries[country_id] as Dictionary).get(key)
	if entry is Dictionary:
		return entry
	return {}


## The integer value, or `null` when the source has none.
func value(country_id: String, key: String) -> Variant:
	var entry := figure(country_id, key)
	if entry.is_empty() or not entry.has("value"):
		return null
	var raw: Variant = entry["value"]
	if raw is int:
		return raw
	if raw is float:
		return int(raw)
	return null


## The as-of year, or 0 when the figure is derived from the map outline (which has no
## year of its own) or absent.
func year(country_id: String, key: String) -> int:
	var entry := figure(country_id, key)
	var raw: Variant = entry.get("year", 0)
	return int(raw) if raw is int else 0


func is_derived(country_id: String, key: String) -> bool:
	return bool(figure(country_id, key).get("derived", false))


## "2019", or "map outline" for a derived figure, or "" when there is no figure.
func as_of_label(country_id: String, key: String) -> String:
	var entry := figure(country_id, key)
	if entry.is_empty():
		return ""
	var raw: Variant = entry.get("year")
	if raw is int:
		return str(raw)
	return str(entry.get("as_of_label", ""))


## How many figures this record has, for a test or a summary line.
func figure_count(country_id: String) -> int:
	if not has(country_id):
		return 0
	var entry := _countries[country_id] as Dictionary
	var total := 0
	for definition: Dictionary in INDICATORS:
		if entry.get(str(definition["key"])) is Dictionary:
			total += 1
	return total


## Thousands separators, ASCII commas, no locale dependency: 163046161 → "163,046,161".
## Written by hand because the project formats numbers the same way on every device.
static func format_integer(value: int) -> String:
	var digits := str(absi(value))
	var out := ""
	var count := 0
	for index in range(digits.length() - 1, -1, -1):
		out = digits[index] + out
		count += 1
		if count % 3 == 0 and index > 0:
			out = "," + out
	return ("-" if value < 0 else "") + out


## One line for a dossier row: "163,046,161 people (2019)", or the missing text.
## `derived` figures say so in words rather than pretending to have a year.
func describe(country_id: String, definition: Dictionary) -> String:
	var key := str(definition["key"])
	var entry := figure(country_id, key)
	if entry.is_empty():
		return missing_text
	var unit := str(definition.get("unit", ""))
	var number := format_integer(int(entry.get("value", 0)))
	if bool(entry.get("derived", false)):
		return "%s %s (derived from the map outline)" % [number, unit]
	return "%s %s (%s)" % [number, unit, as_of_label(country_id, key)]
