class_name CurrencyCatalog
extends RefCounted
## The sourced currency for every record that has one, loaded read-only.
##
## The file this reads is generated by `tools/build_currency.py` from Unicode CLDR
## 48.0.0, which names a current currency for the region of a record's *own* ISO
## 3166-1 alpha-2 code. A record with no code of its own, or a region the source leaves
## ambiguous, has **no entry at all**: `describe()` then returns "Not available" and the
## dossier says so. Nothing here borrows a parent country's currency, and nothing here
## converts, prices or predicts anything.
##
## Deliberately absent: any write path, any link to `WorldState`, the simulation or a
## save. A currency is a label this build shows; a test fails if `src/core/sim` or
## `src/core/save` ever mentions it.

const DEFAULT_PATH := "res://data/world/currency.json"
const MISSING_TEXT := "Not available"

var schema := 0
var notice := ""
var source: Dictionary = {}
var matched_count := 0
var record_count := 0

var _countries: Dictionary = {}


static func load_default() -> CurrencyCatalog:
	return from_file(DEFAULT_PATH)


static func from_file(path: String) -> CurrencyCatalog:
	var catalog := CurrencyCatalog.new()
	var data: Variant = DataLoader.load_json(path)
	if data is Dictionary:
		catalog._read(data as Dictionary)
	return catalog


func _read(data: Dictionary) -> void:
	schema = int(data.get("schema", 0))
	notice = str(data.get("notice", ""))
	source = data.get("source", {}) if data.get("source") is Dictionary else {}
	matched_count = int(data.get("matched_count", 0))
	record_count = int(data.get("record_count", 0))
	var countries: Variant = data.get("countries")
	if not countries is Dictionary:
		return
	for country_id: String in (countries as Dictionary):
		var entry: Variant = (countries as Dictionary)[country_id]
		if not entry is Dictionary:
			continue
		var code := str((entry as Dictionary).get("iso_4217", ""))
		var name := str((entry as Dictionary).get("name", ""))
		# A code without a name is unusable, and a name without a code cannot be
		# checked against anything: both are dropped rather than half-shown.
		if not _is_code(code) or name.strip_edges().is_empty():
			continue
		_countries[country_id] = {
			"code": code,
			"name": name,
			"symbol": str((entry as Dictionary).get("symbol", "")),
			"since": str((entry as Dictionary).get("current_since", "")),
		}


## True for a three-letter uppercase ISO 4217 code.
static func _is_code(code: String) -> bool:
	if code.length() != 3:
		return false
	for index in 3:
		var letter := code.unicode_at(index)
		if letter < 65 or letter > 90:
			return false
	return true


func is_loaded() -> bool:
	return not _countries.is_empty()


func count() -> int:
	return _countries.size()


func has(country_id: String) -> bool:
	return _countries.has(country_id)


## `{code, name, symbol, since}` for a record with a sourced currency, else `{}`.
func entry(country_id: String) -> Dictionary:
	if not has(country_id):
		return {}
	return (_countries[country_id] as Dictionary).duplicate()


## "Bangladeshi Taka (BDT)" — or "Not available" when the source names none. The
## dossier shows exactly this string, so a gap is never hidden behind a blank.
func describe(country_id: String) -> String:
	var found := entry(country_id)
	if found.is_empty():
		return MISSING_TEXT
	return "%s (%s)" % [str(found["name"]), str(found["code"])]


## The sentence under the dossier's Currency row: where the value came from, or why
## there is none. Empty when the catalogue itself failed to load, so a broken file
## cannot produce a confident-sounding caption.
func note(country_id: String) -> String:
	if not is_loaded():
		return ""
	if not has(country_id):
		return ("The CLDR source names no current currency for this record's own code, "
				+ "and this build does not borrow one from another record.")
	return ("Current currency as Unicode CLDR records it%s. Not a rate, a price or a forecast."
			% ((" since " + str(entry(country_id)["since"]))
				if not str(entry(country_id)["since"]).is_empty() else ""))
