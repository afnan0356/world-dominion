extends TestCase
## Save and load: the part of the game that must never lose a campaign and must
## never pretend a damaged file is fine.
##
## Every test writes into its own scratch directory under `user://`, never into the
## player's save folder, and deletes it afterwards. Most fixtures are derived from a
## real save at run time (and re-signed with the shipped checksum function) rather
## than checked in as opaque blobs: a checked-in checksum would have to be
## regenerated by hand every time the canonical encoding changed.
##
## One fixture *is* frozen on purpose: `tests/fixtures/save_schema1_frozen.json`.
## It is a schema 1 save written before the world data was reorganised into
## per-country folders, and `test_a_frozen_older_save_still_loads` proves that the
## data reorganisation did not strand it. It is never regenerated, because a
## regenerated "old" save would prove nothing.

## A system-free world state to save. The calendar is registered so the state hash
## covers a realistic clock, but no test here needs systems to run.
var _atlas: WorldAtlas


func _load() -> void:
	if _atlas == null:
		_atlas = WorldAtlas.load_default()


func _world(seed_value: int = 424242) -> WorldState:
	_load()
	var config := CampaignConfig.new()
	config.scenario_id = "modern_world_2026"
	config.country_id = "BGD"
	config.start_date = "2026-01-01"
	var record := _atlas.registry.get_country("BGD")
	config.metadata = {"scenario_name": "Modern World",
			"country_name": record.name if record != null else "Bangladesh"}
	var world := WorldState.new_campaign(config, _atlas.registry, DataStamp.compute(_atlas),
			seed_value)
	world.wallet.add(GameWallet.Currency.GOLD_COINS, 250)
	world.wallet.add(GameWallet.Currency.DIAMONDS, 7)
	world.add_playtime(90.0)
	return world


func _store(dir_name: String = "user://test_save_dir") -> SaveStore:
	var store := SaveStore.new(dir_name)
	_clear_directory(store.directory())
	return store


## Writes `payload` back with a valid checksum, so a test can prove that a *valid*
## checksum still does not let bad values through.
func _resign(payload: Dictionary) -> String:
	payload[SaveFile.CHECKSUM_KEY] = SaveFile.checksum_of(payload)
	return SaveFile.serialize(payload)


func _payload_of(store: SaveStore, slot: String) -> Dictionary:
	var parsed := SaveFile.parse(_read(store.path_for(slot)))
	return parsed["payload"] if parsed["payload"] is Dictionary else {}


func _read(path: String) -> String:
	if not FileAccess.file_exists(path):
		return ""
	return FileAccess.get_file_as_string(path)


func _write(path: String, text: String) -> void:
	# A save directory is created by SaveStore.save(); a fixture written by hand has
	# to create it itself, or FileAccess.open silently returns null.
	DirAccess.make_dir_recursive_absolute(path.get_base_dir())
	var file := FileAccess.open(path, FileAccess.WRITE)
	if file == null:
		return
	file.store_string(text)
	file.close()


func _save(store: SaveStore, slot: String, world: WorldState, when: String = "") -> Dictionary:
	var stamp := when if not when.is_empty() else "2026-02-01T00:00:00Z"
	return store.save(slot, world, "2026-01-01T00:00:00Z", stamp)


func _clear_directory(path: String) -> void:
	var dir := DirAccess.open(path)
	if dir == null:
		return
	for file_name: String in dir.get_files():
		dir.remove(file_name)


# --- Round trip ------------------------------------------------------------

func test_a_save_round_trips_exactly() -> void:
	var store := _store()
	var world := _world()
	var saved := _save(store, "1", world)
	check_true(bool(saved["ok"]), "saving a healthy world succeeds (%s)" % str(saved["errors"]))
	check_gt(float(saved["bytes"]), 0.0, "the save reports its size in bytes")
	check_gte(float(saved["milliseconds"]), 0.0, "the save reports how long it took")
	check_true(store.exists("1"), "the save file exists in slot 1")

	var loaded := store.load_slot("1", _atlas.registry)
	check_true(bool(loaded["ok"]), "the save loads (%s)" % str(loaded["errors"]))
	check_eq(loaded["errors"].size(), 0, "a healthy save loads without errors")
	check_eq(loaded["warnings"].size(), 0, "a healthy save loads without warnings")
	if not bool(loaded["ok"]):
		return
	var restored: WorldState = loaded["world"]
	check_not_null(restored, "the loaded world exists")
	if restored == null:
		return
	check_eq(restored.state_hash(), world.state_hash(),
			"loading a save reproduces the exact state hash")
	check_eq(restored.player_country_id, "BGD", "the player's country survives")
	check_eq(restored.seed_value, world.seed_value, "the seed survives")
	check_eq(restored.current_date().format_short(), world.current_date().format_short(),
			"the in-game date survives")
	check_eq(restored.wallet.gold_coins(), 250, "gold coins round-trip exactly")
	check_eq(restored.wallet.diamonds(), 7, "diamonds round-trip exactly")
	check_gte(restored.playtime_seconds, 90.0, "the playtime counter survives")
	var summary: Dictionary = loaded["summary"]
	check_eq(str(summary["slot"]), "1", "the summary names its slot")
	check_eq(str(summary["player_country_id"]), "BGD", "the summary names the country")
	check_false(str(summary["date_label"]).is_empty(), "the summary carries the in-game date")
	check_false(str(summary["last_saved_at"]).is_empty(), "the summary carries the save time")
	check_gte(float(loaded["milliseconds"]), 0.0, "the load reports how long it took")
	check_gt(float(saved["bytes"]), 200.0, "a save is more than a header")
	check_true(float(saved["bytes"]) < 262144.0, "a save is far smaller than the map data")
	_clear_directory(store.directory())


func test_saves_never_contain_map_geometry() -> void:
	var store := _store()
	var world := _world()
	_save(store, "1", world)
	var text := _read(store.path_for("1"))
	check_false(text.contains("\"geometry\""), "the save has no geometry section")
	check_false(text.contains("\"polygons\""), "the save has no polygon data")
	check_false(text.contains("\"paths\""), "the save has no path data")
	check_true(text.to_utf8_buffer().size() < 65536,
			"a campaign save stays small: the map is referenced, not copied")
	var payload := _payload_of(store, "1")
	check_true(payload.get("data_stamp") is Dictionary,
			"the save references the world data by stamp, not by copying it")
	var stamp: Dictionary = payload.get("data_stamp")
	check_false(str(stamp.get("label", "")).is_empty(),
			"the data stamp is readable, so a player can be told which data a save needs")
	check_false(str(stamp.get("ids_fingerprint", "")).is_empty(),
			"the data stamp fingerprints the country ids the save refers to")
	_clear_directory(store.directory())


# --- Refusals --------------------------------------------------------------

func test_a_tampered_save_is_refused_and_left_untouched() -> void:
	var store := _store()
	var world := _world()
	_save(store, "1", world)
	var payload := _payload_of(store, "1")
	var world_data: Dictionary = payload["world"]
	world_data["seed"] = 999
	var tampered := SaveFile.serialize(payload)  # same checksum, different content
	_write(store.path_for("1"), tampered)
	var parsed := SaveFile.parse(tampered)
	check_false(bool(parsed["ok"]), "a checksum mismatch is a refusal")
	check_true(str(parsed["player_error"]).to_lower().contains("damaged")
			or str(parsed["player_error"]).to_lower().contains("changed"),
			"the player is told the file changed (%s)" % str(parsed["player_error"]))
	var loaded := store.load_slot("1", _atlas.registry, false)
	check_false(bool(loaded["ok"]), "the store refuses the tampered file")
	check_eq(_read(store.path_for("1")), tampered, "a refused save is never rewritten")
	_clear_directory(store.directory())


func test_empty_truncated_and_foreign_files_are_refused() -> void:
	var store := _store()
	store.ensure_directory()
	for text: String in ["", "   ", "{\"format\": \"world-dominion-save\"", "not json at all",
			"[]", "{\"format\": \"another-game\"}"]:
		_write(store.path_for("1"), text)
		var loaded := store.load_slot("1", _atlas.registry, false)
		check_false(bool(loaded["ok"]), "'%s…' is refused" % text.substr(0, 16))
		check_false(str(loaded["player_error"]).is_empty(),
				"every refusal carries a plain-language reason")
		check_false(str(loaded["player_error"]).contains("at "),
				"the player-facing reason is not a stack trace")
	_clear_directory(store.directory())


func test_bad_numbers_and_types_are_refused_even_with_a_valid_checksum() -> void:
	var store := _store()
	_save(store, "1", _world())
	var original := _payload_of(store, "1")

	var cases: Array = [
		["fractional day", {"day_index": 1.5, "speed": 2}],
		["day as text", {"day_index": "100", "speed": 2}],
		["overflowing day", {"day_index": 99999999999, "speed": 2}],
		["negative day", {"day_index": -3, "speed": 2}],
		["speed out of range", {"day_index": 100, "speed": 99}],
		["missing speed", {"day_index": 100}],
	]
	for entry: Array in cases:
		var payload: Dictionary = original.duplicate(true)
		var world_data: Dictionary = payload["world"]
		world_data["clock"] = entry[1]
		_write(store.path_for("1"), _resign(payload))
		var refused := store.load_slot("1", _atlas.registry, false)
		check_false(bool(refused["ok"]), "%s is refused by the loader" % str(entry[0]))
		check_false(str(refused["player_error"]).is_empty(),
				"%s has a plain reason" % str(entry[0]))

	# Infinite numbers cannot even be serialised, which is the first line of
	# defence: the save layer refuses to write a value no reader can trust.
	var infinite: Array = []
	var bad_payload: Dictionary = original.duplicate(true)
	(bad_payload["world"] as Dictionary)["playtime_seconds"] = INF
	check_eq(SaveFile.serialize(bad_payload), "", "an infinite value cannot be serialised")
	check_true(CanonicalJson.sha256(INF, infinite).is_empty(),
			"hashing an infinite value fails rather than inventing a digest")
	check_false(infinite.is_empty(), "and it says why")
	_clear_directory(store.directory())


func test_unknown_country_ids_are_refused() -> void:
	var store := _store()
	_save(store, "1", _world())
	var payload := _payload_of(store, "1")
	var world_data: Dictionary = payload["world"]
	world_data["player_country_id"] = "ZZZ"
	_write(store.path_for("1"), _resign(payload))
	var loaded := store.load_slot("1", _atlas.registry, false)
	check_false(bool(loaded["ok"]), "a save naming a country that does not exist is refused")
	var joined := " ".join(loaded["errors"])
	# Editing the id also breaks the state hash, and that check runs first: the file
	# is refused before any country is looked up, which is the safest order.
	check_true(joined.to_lower().contains("hash") or joined.to_lower().contains("zzz"),
			"the developer log names the problem (%s)" % joined)
	check_false(loaded["errors"].is_empty(), "the developer log has the detail")
	# The registry check itself: a state that carries an id this build does not ship
	# is refused, and the message names the country.
	var data: Dictionary = _world().to_dict()
	data["player_country_id"] = "ZZZ"
	var issues: Array = []
	var tampered := WorldState.from_dict(data, issues)
	if tampered != null:
		var named := " ".join(tampered.validation_errors(_atlas.registry))
		check_true(named.contains("ZZZ"),
				"the registry check names the unknown country (%s)" % named)
	_clear_directory(store.directory())


func test_a_newer_schema_is_refused_and_never_touched() -> void:
	var store := _store()
	_save(store, "1", _world())
	var payload := _payload_of(store, "1")
	payload["schema_version"] = SaveFile.SCHEMA_VERSION + 5
	var text := _resign(payload)
	_write(store.path_for("1"), text)
	var parsed := SaveFile.parse(text)
	check_false(bool(parsed["ok"]), "a newer schema is not loaded")
	check_true(bool(parsed["newer"]), "the parser flags it as newer")
	check_true(str(parsed["player_error"]).to_lower().contains("newer"),
			"the player is told the save is from a newer version")
	var loaded := store.load_slot("1", _atlas.registry, false)
	check_false(bool(loaded["ok"]), "the store refuses it too")
	check_eq(_read(store.path_for("1")), text, "a refused newer save is left byte-for-byte intact")
	var migration := SaveMigrations.migrate(payload)
	check_false(bool(migration["ok"]), "migrations never run downward")
	_clear_directory(store.directory())


func test_schema_one_save_is_migrated_and_keeps_the_wallet() -> void:
	var store := _store()
	_save(store, "1", _world())
	var payload := _payload_of(store, "1")
	# Rebuild the older shape: the wallet was top level, stream positions did not
	# exist, and the state hash was not part of the file.
	var world_data: Dictionary = payload["world"]
	payload["wallet"] = world_data["wallet"]
	world_data.erase("wallet")
	world_data.erase("streams")
	payload.erase(SaveFile.STATE_HASH_KEY)
	payload["schema_version"] = 1
	var text := _resign(payload)
	_write(store.path_for("1"), text)
	var parsed := SaveFile.parse(text)
	check_true(bool(parsed["needs_migration"]), "a schema 1 file is recognised, not rejected")
	check_false(bool(parsed["ok"]), "but it is not loaded before it is migrated")
	var loaded := store.load_slot("1", _atlas.registry)
	check_true(bool(loaded["ok"]), "a schema 1 save loads through migration (%s)"
			% str(loaded["errors"]))
	check_true(bool(loaded["migrated"]), "the load reports that a migration happened")
	check_false(loaded["warnings"].is_empty(), "the migration is listed for the log")
	if not bool(loaded["ok"]):
		return
	var restored: WorldState = loaded["world"]
	check_eq(restored.wallet.gold_coins(), 250, "the migrated save keeps its gold coins")
	check_eq(restored.wallet.diamonds(), 7, "the migrated save keeps its diamonds")
	check_eq(restored.state_hash(), _world().state_hash(),
			"the migrated save hashes like the campaign it came from")
	# Loading never rewrites the file: a migration is applied in memory, and the newer
	# shape is written the next time the player saves.
	var untouched := _payload_of(store, "1")
	check_eq(int(untouched.get("schema_version", 0)), 1,
			"loading does not silently rewrite the file to the new schema")
	_save(store, "1", restored)
	var rewritten := _payload_of(store, "1")
	check_eq(int(rewritten.get("schema_version", 0)), SaveFile.SCHEMA_VERSION,
			"loading does not silently rewrite the file to the new schema")
	_clear_directory(store.directory())


# --- Durability ------------------------------------------------------------

func test_a_frozen_older_save_still_loads() -> void:
	# The file was written by Milestone 03 before the per-country folders existed.
	# It is frozen: if a future change to the data or the format cannot load it, this
	# test fails and the change needs a migration rather than a new fixture.
	var text := FileAccess.get_file_as_string("res://tests/fixtures/save_schema1_frozen.json")
	check_false(text.is_empty(), "the frozen fixture is present")
	var parsed := SaveFile.parse(text)
	check_true(bool(parsed["needs_migration"]),
			"the frozen schema 1 file is intact and recognised as older (not rejected)")
	check_false(bool(parsed["ok"]), "an older file is not loaded before it is migrated")
	var store := _store("user://test_frozen_save")
	_write(store.path_for("1"), text)
	var loaded := store.load_slot("1", _atlas.registry, false)
	check_true(bool(loaded["ok"]),
			"a save frozen before the data reorganisation still loads (%s)"
			% str(loaded["errors"]))
	check_true(bool(loaded["migrated"]), "it is reported as migrated, not silently rewritten")
	if not bool(loaded["ok"]):
		_clear_directory(store.directory())
		return
	var world: WorldState = loaded["world"]
	check_eq(world.seed_value, 424242, "the frozen save keeps its seed")
	check_eq(world.player_country_id, "BGD", "the frozen save still resolves its country")
	check_eq(world.current_date().format_short(), "2026-03-01",
			"the frozen save keeps its in-game date")
	check_eq(world.clock.speed, 2, "the frozen save keeps its speed")
	check_eq(world.wallet.gold_coins(), 250, "gold coins survive the data reorganisation")
	check_eq(world.wallet.diamonds(), 7, "diamonds survive the data reorganisation")
	check_eq(world.data_stamp.get("label", ""), DataStamp.compute(_atlas).get("label", ""),
			"the frozen save's data stamp still matches the shipped world data")
	check_eq(FileAccess.get_file_as_string(store.path_for("1")), text,
			"loading the frozen file did not rewrite it")
	_clear_directory(store.directory())


func test_a_failed_write_leaves_the_previous_save_intact() -> void:
	for stage in [1, 2, 3]:
		var store := _store("user://test_save_dir_stage_%d" % stage)
		var first := _world(1111)
		check_true(bool(_save(store, "1", first)["ok"]), "the first save succeeds")
		var before := _read(store.path_for("1"))
		var second := _world(2222)
		store.inject_failure_stage = stage
		var failed := _save(store, "1", second)
		check_false(bool(failed["ok"]), "stage %d fails on purpose" % stage)
		check_false(failed["errors"].is_empty(), "stage %d is explained in the log" % stage)
		check_false(str(failed["player_error"]).is_empty(),
				"stage %d has a plain-language reason" % stage)
		check_eq(_read(store.path_for("1")), before,
				"stage %d leaves the old file byte-for-byte intact" % stage)
		check_false(FileAccess.file_exists(store._temp_path_for("1")),
				"stage %d cleans up its temporary file" % stage)
		var loaded := store.load_slot("1", _atlas.registry)
		check_true(bool(loaded["ok"]), "stage %d leaves a loadable save" % stage)
		if bool(loaded["ok"]):
			check_eq((loaded["world"] as WorldState).seed_value, 1111,
					"stage %d did not half-apply the new save" % stage)
		_clear_directory(store.directory())


func test_the_backup_is_used_when_the_main_save_is_damaged() -> void:
	var store := _store()
	var first := _world(1111)
	check_true(bool(_save(store, "1", first, "2026-01-15T00:00:00Z")["ok"]), "first save")
	var second := _world(2222)
	check_true(bool(_save(store, "1", second, "2026-02-15T00:00:00Z")["ok"]), "second save")
	check_true(store.backup_exists("1"), "the previous save became a backup")
	_write(store.path_for("1"), "{\"format\": \"world-dominion-save\", broken")
	var loaded := store.load_slot("1", _atlas.registry)
	check_true(bool(loaded["ok"]), "the backup rescues the slot")
	check_true(bool(loaded["used_backup"]), "the load says a backup was used")
	check_false(loaded["warnings"].is_empty(), "the substitution is reported, never silent")
	check_false(loaded["errors"].is_empty(), "the main file's reason is kept for the log")
	if bool(loaded["ok"]):
		check_eq((loaded["world"] as WorldState).seed_value, 1111,
				"the backup is the previous campaign, not a fabricated one")
	var entry := store.inspect("1", _atlas.registry)
	check_true(bool(entry["valid"]), "the slot reports itself as recoverable")
	check_true(bool(entry["has_backup"]), "and reports that a backup exists")
	_clear_directory(store.directory())


func test_restore_backup_and_delete_are_explicit_actions() -> void:
	var store := _store()
	_save(store, "1", _world(1111), "2026-01-15T00:00:00Z")
	_save(store, "1", _world(2222), "2026-02-15T00:00:00Z")
	check_true(store.restore_backup("1"), "a backup can be restored on purpose")
	var after_restore := store.load_slot("1", _atlas.registry, false)
	check_true(bool(after_restore["ok"]), "the restored slot loads")
	if bool(after_restore["ok"]):
		check_eq((after_restore["world"] as WorldState).seed_value, 1111,
				"restoring brings back the previous save")
	check_true(store.delete("1"), "a slot can be deleted")
	check_false(store.exists("1"), "the deleted slot is gone")
	check_false(store.delete("nonsense"), "an unknown slot cannot be deleted")
	check_false(store.restore_backup("2"), "a slot without a backup cannot be restored")
	_clear_directory(store.directory())


# --- Slots and transfer ----------------------------------------------------

func test_slots_are_listed_honestly() -> void:
	var store := _store()
	store.ensure_directory()
	var empty := store.list_slots(_atlas.registry)
	check_eq(empty.size(), SaveStore.SLOT_IDS.size(), "every slot is listed, empty or not")
	for entry: Dictionary in empty:
		check_false(bool(entry["exists"]), "an empty slot says it is empty")
		check_false(bool(entry["valid"]), "an empty slot is not valid")
	check_false(store.has_any_valid(_atlas.registry), "no slots are valid yet")
	check_eq(store.latest_valid_slot(_atlas.registry), "", "there is nothing to continue")

	_save(store, "2", _world(5), "2026-03-01T00:00:00Z")
	_save(store, "1", _world(6), "2026-01-20T00:00:00Z")
	check_true(store.has_any_valid(_atlas.registry), "a saved slot is valid")
	check_eq(store.latest_valid_slot(_atlas.registry), "2",
			"the most recently saved slot wins, not the highest number")
	_write(store.path_for("3"), "damaged")
	var listed := store.list_slots(_atlas.registry)
	check_eq(listed.size(), SaveStore.SLOT_IDS.size(), "a damaged slot still appears")
	for entry: Dictionary in listed:
		if str(entry["slot"]) == "3":
			check_true(bool(entry["exists"]), "the damaged slot is not reported as empty")
			check_false(bool(entry["valid"]), "the damaged slot is not valid")
			check_false(str(entry["player_error"]).is_empty(),
					"the damaged slot explains itself in the list")
	check_eq(SaveStore.slot_label(SaveStore.AUTOSAVE_SLOT), "Autosave",
			"the autosave slot is named for the player")
	_clear_directory(store.directory())


func test_export_and_import_round_trip_through_a_file() -> void:
	var store := _store()
	_save(store, "1", _world(31337))
	var exported := store.export_slot("1", "user://test_export.json")
	check_true(bool(exported["ok"]), "a slot can be exported (%s)" % str(exported["errors"]))
	var text := _read("user://test_export.json")
	check_false(text.is_empty(), "the exported file has content")
	var imported := store.import_file("user://test_export.json", _atlas.registry)
	check_true(bool(imported["ok"]), "the exported file imports again (%s)"
			% str(imported["errors"]))
	check_eq(str(imported["summary"].get("player_country_id", "")), "BGD",
			"the imported summary names the same country")
	var written := store.write_imported_text("2", str(imported["text"]))
	check_true(bool(written["ok"]), "the imported text can be written into a slot")
	var loaded := store.load_slot("2", _atlas.registry)
	check_true(bool(loaded["ok"]), "the imported slot loads")
	if bool(loaded["ok"]):
		check_eq((loaded["world"] as WorldState).seed_value, 31337,
				"the imported slot is the exported campaign")
	var bad := store.import_file("user://test_export_bad.json", _atlas.registry)
	check_false(bool(bad["ok"]), "a missing import file is refused")
	_write("user://test_export_bad.json", "{\"format\": \"other\"}")
	check_false(bool(store.import_file("user://test_export_bad.json",
			_atlas.registry)["ok"]), "a foreign import file is refused")
	DirAccess.remove_absolute("user://test_export.json")
	DirAccess.remove_absolute("user://test_export_bad.json")
	_clear_directory(store.directory())


